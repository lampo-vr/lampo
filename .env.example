# Lampo server settings for docker compose. Copy to .env and fill in. Every setting is optional unless marked.
# The same variables work without Docker (VR_MODE=server npm start). Reference: docs/configuration.md, docs/docker.md,
# docs/go-live.md (the first deploy, step by step).

# --- where people reach it (required) ------------------------------------------------------------------------------
# Caddy gets a certificate for this domain (point its DNS at the server first).
VR_DOMAIN=review.example.com
# The URL people open: scheme and host only, no path. Only this host is served, writes must come from this origin,
# cookies are Secure on https. Plain http is refused unless the host is this machine (or VR_ALLOW_HTTP=1, for a closed
# test network only).
VR_PUBLIC_URL=https://review.example.com
# Caddy is in front, on the compose network (private addresses): believe its forwarding headers (client IP, https),
# nobody else's. Required with an https VR_PUBLIC_URL: the server refuses to start without it.
VR_TRUST_PROXY=uniquelocal
# Where people who use this server get its source (AGPL-3.0 §13). Point it at your fork if you changed the code.
#VR_SOURCE_URL=https://example.org/you/lampo
# Behind a CDN proxy that must not carry video (Cloudflare's, for example): a second name for this server, DNS only,
# served by the same app. Video, downloads and one-time uploads go there by signed URLs; it answers nothing else.
# docs/server-mode.md#a-host-of-its-own-for-video
#VR_MEDIA_ORIGIN=https://media.review.example.com

# --- the team ------------------------------------------------------------------------------------------------------
# Your team's name, shown on review links next to who shared them and in invite emails.
#VR_ORG_NAME=Northwind Studio
# Who may make a new workspace in the app: owners (whoever runs the server, LAMPO_OPERATOR below; the default) | anyone signed in
#VR_WORKSPACE_CREATE=owners
# With anyone: how many workspaces one account may make, the one its sign-up gave it included (default 3)
#VR_WORKSPACE_CREATE_LIMIT=3
# Who runs this server and sees its operator pages (every workspace and account): account emails or ids, comma-separated.
# Unset: the owners of the first workspace.
#LAMPO_OPERATOR=you@example.com
# New accounts start with the first-run checklist; off for people who know Lampo already.
#VR_ONBOARDING=on
# ...and find the sample (Lampo's brand film, two versions, a few notes) in their library; off: only on request.
#VR_ONBOARDING_SAMPLE=on

# --- uploads --------------------------------------------------------------------------------------------------------
# Largest accepted upload (default 20GB).
#VR_UPLOAD_MAX=20GB
# Free disk to keep: below it /readyz fails and uploads that don't fit are refused (default 2GB).
#VR_MIN_FREE=2GB

# --- where renders live (default: the /data volume) ----------------------------------------------------------------
#VR_STORAGE=local
# Bunny Storage + CDN (signed, expiring URLs; don't use Bunny Stream — it re-encodes and breaks frame-exact seeking):
#VR_STORAGE=bunny
#VR_BUNNY_ZONE=acme-review          # storage zone name
#VR_BUNNY_ACCESS_KEY=               # storage zone password (FTP & API access), not the account API key
#VR_BUNNY_REGION=de                 # de (Frankfurt), uk, ny, la, sg, se, br, jh, syd
#VR_BUNNY_CDN_URL=https://acme-review.b-cdn.net
#VR_BUNNY_TOKEN_KEY=                # pull zone token authentication key (required with VR_BUNNY_CDN_URL)
#VR_BUNNY_PREFIX=review             # optional folder inside the zone
# An S3-compatible store (tested against a mock S3; R2, Hetzner Object Storage, MinIO, Backblaze B2 and Bunny S3 speak
# the same API):
#VR_STORAGE=s3
#VR_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#VR_S3_REGION=auto
#VR_S3_BUCKET=review
#VR_S3_ACCESS_KEY_ID=
#VR_S3_SECRET_ACCESS_KEY=
#VR_S3_PREFIX=review
#VR_S3_PRESIGN=true                 # browsers get presigned URLs; false = stream through the server
# Local working copies of remote renders (ffmpeg needs files), size cap:
#VR_WORK_CACHE=20GB

# --- email (docs/email.md): invites, sign-up confirmations, password resets, account notices ------------------------
# Without a relay nothing is sent: every message is written to /data/cache/outbox/ and the start says so.
# Brevo: the SMTP login (its @ written as %40) and an SMTP key (not an API key). Try it: vr admin mail-test you@…
# Port 587 (smtp://, upgraded with STARTTLS): Hetzner Cloud blocks outgoing 25 and 465 by default.
#VR_SMTP_URL=smtp://123abc%40smtp-brevo.com:<smtp key>@smtp-relay.brevo.com:587
#VR_MAIL_FROM=Lampo <hello@review.example.com>   # the sender people see; a domain you authenticated (SPF, DKIM, DMARC)
#VR_MAIL_REPLY_TO=
#VR_MAIL_PER_HOUR=200                # the server's own cap (Brevo's free plan: 300 a day)
# Who may sign up on their own: off (default) | invite (addresses a pending invite names) | open (anyone, each into a
# workspace of their own; refuses to start without VR_TERMS_URL and VR_PRIVACY_URL)
#VR_SIGNUP=off

# --- your legal pages (docs/configuration.md#legal-pages): linked, never written by the app; http(s) URLs -----------
# Who runs this server (an imprint): at the foot of the sign-in screens, review links and Settings → About.
#VR_IMPRINT_URL=https://example.com/imprint
#VR_TERMS_URL=https://example.com/terms
#VR_PRIVACY_URL=https://example.com/privacy

# --- speech-to-text for voice notes (all local by default; docs/speech.md) -----------------------------------------
#VR_STT=local                       # local | http | off
#VR_STT_MODEL=auto                  # auto (Parakeet v3 on CPU, Whisper-turbo with a GPU) | parakeet-v3 | whisper-turbo | qwen3-asr-1.7b | /data/models/x.gguf
#VR_STT_LANGUAGES=de,en             # languages your team speaks (first = fallback); empty = any
#VR_STT_VOCABULARY=Caption,B-Roll   # opt-in terms for Whisper's prompt
#VR_STT_THREADS=4
#VR_STT_IDLE_MINUTES=30             # unload the model (1–3 GB) when idle
#VR_STT_PREFETCH=1                  # download the model at start (the image default); 0 = on the first voice note
# Or an OpenAI-compatible server instead of the local engine (a GPU box, a hosted API):
#VR_STT=http
#VR_STT_URL=http://gpu-box:8080
#VR_STT_API_KEY=
#VR_STT_HTTP_MODEL=whisper-1

# --- pre-review text checks -----------------------------------------------------------------------------------------
#VR_OCR=auto                        # auto | tesseract | off

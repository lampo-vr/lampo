# Lampo with its app host behind a CDN proxy (Cloudflare here) and a media host of its own (docs/go-live.md → Behind
# a CDN proxy). Use it in place of deploy/Caddyfile: mount it as /etc/caddy/Caddyfile, set LAMPO_DOMAIN (the app host,
# proxied by the CDN) and LAMPO_MEDIA_DOMAIN (DNS only, straight to this server), and LAMPO_MEDIA_ORIGIN=https://<media host>
# for the app.
#
# No `encode`: the app compresses its own answers, and compression would hold the live stream back. No access log: it
# would keep visitors' addresses. The app sends its own security headers (CSP, HSTS, …).

# The CDN's addresses: Cloudflare's, as published at https://www.cloudflare.com/ips-v4 and /ips-v6. They change rarely;
# compare them with the published list when you update, since visitors behind a range missing here are refused.
(cdn) {
	remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}

{$LAMPO_DOMAIN} {
	# The certificate the CDN checks between itself and this server (Cloudflare: an Origin CA certificate for this name,
	# SSL mode Full (strict)). Browsers never see it; Caddy doesn't renew it.
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		# Recommended: authenticated origin pulls. The CDN shows a client certificate only your zone's settings carry, so
		# another zone on the same CDN pointed at this server's address is refused before any request. Cloudflare's
		# addresses alone don't prove the request is your zone's.
		# client_auth {
		# 	mode require_and_verify
		# 	trust_pool file /etc/caddy/certs/origin-pull-ca.pem
		# }
	}

	# Only the CDN reaches the app host: anyone else connecting to this server with this name has the connection closed,
	# so nobody goes around the CDN, and nobody can claim an address in CF-Connecting-IP.
	@cdn {
		import cdn
	}
	handle @cdn {
		reverse_proxy app:4747 {
			# The visitor's address: the CDN sets CF-Connecting-IP (a client can't, through it), and this site alone
			# forwards it as the one X-Forwarded-For address the app reads (LAMPO_TRUST_PROXY names this proxy). Without it
			# every visitor looks like a handful of CDN addresses, and the sign-in limits lock everyone out.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			# The live stream (/api/events) and /mcp: every byte at once.
			flush_interval -1
			transport http {
				dial_timeout 5s
				# No read, write or response timeouts: the live stream and an agent's wait stay open, and uploads take as
				# long as they take. The app limits bodies itself (LAMPO_UPLOAD_MAX).
			}
			# A restart of the app takes seconds: hold GET/HEAD requests that long instead of answering 502.
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}
	handle {
		abort
	}
}

{$LAMPO_MEDIA_DOMAIN} {
	# Its own certificate from Let's Encrypt (the name is DNS only, so it points here). The app answers only these paths
	# on this host and refuses the rest itself; Caddy keeps the rest away too.
	@media path /media/s/* /media/z/* /media/f/* /api/uploads/direct/* /healthz /readyz
	handle @media {
		reverse_proxy app:4747 {
			# Direct visitors: Caddy sets X-Forwarded-For to the visitor's address itself (it trusts none sent to it).
			flush_interval -1
			transport http {
				dial_timeout 5s
				# No timeouts: a folder's zip or a whole render in one PUT can take a long time.
			}
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}
	handle {
		respond 404
	}
}
